NODE_ENV=development
PORT=4000
# Port 5434 = mapping Docker (npm run db:up). En Docker Compose interne, le backend utilise db:5432.
DATABASE_URL=postgresql://gradehub:gradehub@localhost:5434/gradehub
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum
JWT_EXPIRES_IN=7d

# Tarification (cahier des charges)
FRAIS_SUIVI_XOF=1500
FRAIS_EXPRESS_XOF=0          # 0 = formule express indisponible (prix à fixer)
MAJORATION_ANCIEN_POURCENT=50
ANCIENNETE_SEUIL_ANNEES=2

# Fichiers
STORAGE_DIR=./uploads
SIGNED_URL_TTL_SECONDS=600
RETENTION_SCANS_JOURS=30     # provisoire, à arrêter

# --- Paiement mobile ---
# simulation : aucun argent ne bouge (développement et démonstration)
# paygate    : vrais paiements T-Money et Flooz via PayGate Global (voir docs/PAIEMENT-ET-EMAIL.md)
PAYMENT_PROVIDER=simulation
PAYMENT_WEBHOOK_SECRET=remplacer-par-un-secret-partage-avec-l-operateur   # webhook signé du mode simulation

# Requis seulement avec PAYMENT_PROVIDER=paygate
PAYGATE_AUTH_TOKEN=
PAYGATE_WEBHOOK_KEY=          # 16 caractères minimum, à ajouter à l'URL de rappel : ...?k=<cette clé>
# PAYGATE_BASE_URL=https://paygateglobal.com
# PAYGATE_TIMEOUT_MS=15000

# Notifications
NOTIFICATIONS_ENABLED=true
NOTIF_CANAL=WHATSAPP         # WHATSAPP ou SMS

# --- E-mail : alerte à chaque nouveau message de la page Contact ---
# Laisser SMTP_HOST vide désactive l'envoi (les messages restent visibles dans l'admin).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false             # true pour le port 465 (SSL direct)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                    # ex. GRADE HUB <contact@votre-domaine.tg>
ADMIN_NOTIFY_EMAIL=           # destinataire ; à défaut, l'e-mail saisi dans Admin > Contenu du site
# APP_URL=https://gradehub.example   # lien « Ouvrir les messages » dans l'e-mail

# Seed
SEED_ADMIN_EMAIL=admin@gradehub.local
SEED_ADMIN_PASSWORD=ChangeMe-12345
