# Copier en .env.deploy sur la VM (ne pas committer .env.deploy)
# docker compose --env-file .env.deploy -f docker-compose.yml -f docker-compose.prod.yml up -d

# URL publique du site (CORS backend)
PUBLIC_ORIGIN=http://4.227.180.151

# Mot de passe PostgreSQL (nouveau déploiement uniquement ; volume existant = voir docs/SECURITE.md)
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort

# HTTPS Let's Encrypt (optionnel, domaine requis)
# DOMAIN=gradehub.votredomaine.tg
# CERTBOT_EMAIL=admin@votredomaine.tg

# Compte démo public (mot de passe connu) : laisser false en production
RUN_DEMO=false
