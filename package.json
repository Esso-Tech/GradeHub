{
  "name": "gradehub",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "demo": "npm --prefix backend run demo",
    "demo:reset": "npm --prefix backend run demo:reset",
    "test": "npm --prefix backend test",
    "build:frontend": "npm --prefix frontend run build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose exec backend npx tsx prisma/seed.ts",
    "docker:demo": "docker compose exec backend npx tsx prisma/demo.ts"
  }
}
